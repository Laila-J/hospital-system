# ====== Server ======
NODE_ENV=development
PORT=5000

# ====== Database ======
# Local:   mongodb://127.0.0.1:27017/al-othman-hospital
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/al-othman-hospital
MONGO_URI=mongodb://127.0.0.1:27017/al-othman-hospital

# ====== Auth ======
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=1d
JWT_REMEMBER_EXPIRE=30d

# ====== CORS ======
# URL where the React frontend (Vite) runs
CLIENT_URL=http://localhost:5173

# ====== Email (used for password reset & notifications) ======
# Example uses Gmail SMTP - use an "App Password", not your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Al Othman Hospital <no-reply@alothman.sy>"

# ====== Misc ======
# How many minutes a password reset link stays valid
RESET_TOKEN_EXPIRE_MINUTES=10
